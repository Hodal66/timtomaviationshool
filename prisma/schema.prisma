generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  ADMISSIONS
  FINANCE
  LECTURER
  BRANCH_MANAGER
}

enum ProgrammeType {
  IATA
  ICAO
  ADVANCED_CERTIFICATE
  CERTIFICATE
  ICT
}

enum ApplicationStatus {
  SUBMITTED
  DOCUMENTS_VERIFIED
  REGISTRATION_PAID
  ADMITTED
  ENROLLED
  REJECTED
}

enum Session {
  WEEKDAY
  WEEKEND
}

enum Currency {
  RWF
  USD
  CDF
}

enum PaymentChannel {
  MTN_MOMO
  AIRTEL_MONEY
  BANK_OF_KIGALI
  IM_BANK
  EQUITY
  CASH
}

enum PaymentStatus {
  RECONCILED
  UNMATCHED
  PART_PAYMENT
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum CertificateStatus {
  VALID
  REVOKED
}

model Branch {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  country    String
  users      User[]
  applicants Applicant[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  createdAt    DateTime @default(now())
}

model Programme {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  type           ProgrammeType
  durationMonths Int           @default(6)
  feeRwf         Int
  feeUsd         Int
  applicants     Applicant[]
  certificates   Certificate[]
}

model Intake {
  id         String      @id @default(cuid())
  label      String      @unique
  startsOn   DateTime
  endsOn     DateTime
  applicants Applicant[]
}

model Applicant {
  id          String            @id @default(cuid())
  fullName    String
  email       String?
  phone       String?
  dateOfBirth DateTime?
  source      String            @default("Web")
  status      ApplicationStatus @default(SUBMITTED)
  session     Session           @default(WEEKDAY)
  branchId    String
  branch      Branch            @relation(fields: [branchId], references: [id])
  programmeId String
  programme   Programme         @relation(fields: [programmeId], references: [id])
  intakeId    String
  intake      Intake            @relation(fields: [intakeId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  payments    Payment[]
  attendance  Attendance[]
  certificates Certificate[]

  @@index([status])
  @@index([branchId])
}

model Payment {
  id          String         @id @default(cuid())
  reference   String?        @unique
  amountMinor Int
  currency    Currency       @default(RWF)
  channel     PaymentChannel
  status      PaymentStatus  @default(UNMATCHED)
  applicantId String?
  applicant   Applicant?     @relation(fields: [applicantId], references: [id])
  paidAt      DateTime       @default(now())

  @@index([status])
}

model Attendance {
  id          String           @id @default(cuid())
  applicantId String
  applicant   Applicant        @relation(fields: [applicantId], references: [id])
  classDate   DateTime
  status      AttendanceStatus

  @@unique([applicantId, classDate])
}

model Certificate {
  id          String            @id @default(cuid())
  number      String            @unique
  holderId    String
  holder      Applicant         @relation(fields: [holderId], references: [id])
  programmeId String
  programme   Programme         @relation(fields: [programmeId], references: [id])
  issuer      String            @default("Timtom Aviation School")
  status      CertificateStatus @default(VALID)
  issuedOn    DateTime
}
