generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  ADMISSIONS
  FINANCE
  LECTURER
  BRANCH_MANAGER
  ACADEMIC
  MARKETING
}

enum ProgrammeType {
  IATA
  ICAO
  ADVANCED_CERTIFICATE
  CERTIFICATE
  ICT
}

enum ApplicationStatus {
  SUBMITTED
  DOCUMENTS_VERIFIED
  REGISTRATION_PAID
  ADMITTED
  ENROLLED
  REJECTED
}

enum Session {
  WEEKDAY
  WEEKEND
}

enum Currency {
  RWF
  USD
  CDF
}

enum PaymentChannel {
  MTN_MOMO
  AIRTEL_MONEY
  BANK_OF_KIGALI
  IM_BANK
  EQUITY
  CASH
}

enum PaymentStatus {
  RECONCILED
  UNMATCHED
  PART_PAYMENT
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum CertificateStatus {
  VALID
  REVOKED
}

model Branch {
  vacancies  Vacancy[]
  id         String       @id @default(cuid())
  code       String       @unique
  name       String
  country    String
  users      User[]
  applicants Applicant[]
  rooms      Room[]
  groups     ClassGroup[]
}

model User {
  resources      Resource[]
  claims         PaymentClaim[]
  active         Boolean             @default(true)
  lecturer       LecturerProfile?
  profileChanges ProfileChange[]
  lessonReports  LessonReport[]
  substituteAsks SubstituteRequest[]
  id             String              @id @default(cuid())
  email          String              @unique
  name           String
  passwordHash   String
  role           Role
  branchId       String?
  branch         Branch?             @relation(fields: [branchId], references: [id])
  createdAt      DateTime            @default(now())
  slots          TimetableSlot[]
  assigned       Applicant[]         @relation("Assigned")
}

model Programme {
  meetRules          Json?
  resources          Resource[]
  gradingScheme      Json?
  id                 String           @id @default(cuid())
  code               String           @unique
  name               String
  type               ProgrammeType
  durationMonths     Int?
  feeRwf             Int?
  feeUsd             Int?
  slug               String?          @unique
  qualificationType  String?
  awardingBody       String?
  summary            String?
  description        String?
  objectives         String[]
  entryRequirements  String[]
  deliveryModes      String[]
  modules            Json?
  careers            String[]
  faqs               Json?
  visualTheme        String           @default("default")
  heroImage          String?
  registrationFeeRwf Int?
  status             ContentStatus    @default(DRAFT)
  reviewNotes        String?
  submittedById      String?
  approvedById       String?
  publishedAt        DateTime?
  updatedAt          DateTime         @default(now()) @updatedAt
  events             ProgrammeEvent[]
  applicants         Applicant[]
  certificates       Certificate[]
  groups             ClassGroup[]
}

model Intake {
  id         String       @id @default(cuid())
  label      String       @unique
  startsOn   DateTime
  endsOn     DateTime
  applicants Applicant[]
  groups     ClassGroup[]
}

model Applicant {
  schoolEmail       String?
  grades            Grade[]
  submissions       Submission[]
  exams             ExternalExam[]
  emergencyName     String?
  emergencyPhone    String?
  requests          StudentRequest[]
  tickets           Ticket[]
  attendanceAlertAt DateTime?
  requirementsMet   String[]           @default([])
  admittedAt        DateTime?
  emailVerifiedAt   DateTime?
  id                String             @id @default(cuid())
  fullName          String
  email             String?
  phone             String?
  dateOfBirth       DateTime?
  source            String             @default("Web")
  status            ApplicationStatus  @default(SUBMITTED)
  session           Session            @default(WEEKDAY)
  branchId          String
  branch            Branch             @relation(fields: [branchId], references: [id])
  programmeId       String
  programme         Programme          @relation(fields: [programmeId], references: [id])
  intakeId          String
  intake            Intake             @relation(fields: [intakeId], references: [id])
  classGroupId      String?
  classGroup        ClassGroup?        @relation(fields: [classGroupId], references: [id])
  reference         String?            @unique
  leadSource        String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  language          String?
  guardianName      String?
  guardianPhone     String?
  educationLevel    String?
  institution       String?
  completionYear    Int?
  uploads           Upload[]
  assignedToId      String?
  assignedTo        User?              @relation("Assigned", fields: [assignedToId], references: [id])
  events            ApplicationEvent[]
  documents         DocumentItem[]
  invoices          Invoice[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payments          Payment[]
  attendance        Attendance[]
  certificates      Certificate[]
  notifications     Notification[]

  @@index([status])
  @@index([branchId])
}

model Payment {
  valueRwf    Int?
  claimedBy   String         @default("FINANCE")
  note        String?
  id          String         @id @default(cuid())
  reference   String?        @unique
  amountMinor Int
  currency    Currency       @default(RWF)
  channel     PaymentChannel
  status      PaymentStatus  @default(UNMATCHED)
  applicantId String?
  applicant   Applicant?     @relation(fields: [applicantId], references: [id])
  invoiceId   String?
  invoice     Invoice?       @relation(fields: [invoiceId], references: [id])
  verifiedBy  String?
  paidAt      DateTime       @default(now())

  @@index([status])
}

model Attendance {
  joinAt      DateTime?
  leaveAt     DateTime?
  minutes     Int?
  note        String?
  method      String           @default("ROLL")
  markedAt    DateTime         @default(now())
  id          String           @id @default(cuid())
  applicantId String
  applicant   Applicant        @relation(fields: [applicantId], references: [id])
  sessionId   String
  session     ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status      AttendanceStatus

  @@unique([applicantId, sessionId])
}

model Room {
  id       String          @id @default(cuid())
  name     String
  capacity Int             @default(30)
  branchId String
  branch   Branch          @relation(fields: [branchId], references: [id])
  slots    TimetableSlot[]

  @@unique([branchId, name])
}

model ClassGroup {
  assessments Assessment[]
  id          String          @id @default(cuid())
  name        String          @unique
  programmeId String
  programme   Programme       @relation(fields: [programmeId], references: [id])
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id])
  intakeId    String
  intake      Intake          @relation(fields: [intakeId], references: [id])
  session     Session         @default(WEEKDAY)
  students    Applicant[]
  slots       TimetableSlot[]
}

model TimetableSlot {
  mode           String              @default("CAMPUS")
  meetUrl        String?
  meetEventId    String?
  lessonReports  LessonReport[]
  substituteAsks SubstituteRequest[]
  id             String              @id @default(cuid())
  groupId        String
  group          ClassGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roomId         String
  room           Room                @relation(fields: [roomId], references: [id])
  lecturerId     String
  lecturer       User                @relation(fields: [lecturerId], references: [id])
  dayOfWeek      Int
  startMin       Int
  endMin         Int
  subject        String
  sessions       ClassSession[]

  @@index([dayOfWeek])
}

model ClassSession {
  meetImportedAt DateTime?
  log            Json          @default("[]")
  id             String        @id @default(cuid())
  slotId         String
  slot           TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  records        Attendance[]

  @@unique([slotId, date])
}

model Certificate {
  kind           String            @default("Certificate")
  finalMark      Float?
  issuedBy       String?
  revokedAt      DateTime?
  revokedBy      String?
  revokeReason   String?
  replacesNumber String?
  id             String            @id @default(cuid())
  number         String            @unique
  holderId       String
  holder         Applicant         @relation(fields: [holderId], references: [id])
  programmeId    String
  programme      Programme         @relation(fields: [programmeId], references: [id])
  issuer         String            @default("Timtom Aviation School")
  status         CertificateStatus @default(VALID)
  issuedOn       DateTime
}

enum ContentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum DocStatus {
  PENDING
  RECEIVED
  VERIFIED
  MISSING
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

model ProgrammeEvent {
  id          String    @id @default(cuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  actorName   String
  action      String
  createdAt   DateTime  @default(now())
}

model ApplicationEvent {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  type        String
  message     String
  actorName   String
  createdAt   DateTime  @default(now())

  @@index([applicantId])
}

model DocumentItem {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  kind        String
  status      DocStatus @default(PENDING)
  note        String?

  @@unique([applicantId, kind])
}

model Invoice {
  kind        String        @default("REGISTRATION")
  dueOn       DateTime?
  installment Int?
  remindedAt  DateTime?
  id          String        @id @default(cuid())
  reference   String        @unique
  applicantId String
  applicant   Applicant     @relation(fields: [applicantId], references: [id])
  description String
  amountMinor Int
  currency    Currency      @default(RWF)
  status      InvoiceStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  paidAt      DateTime?
  payments    Payment[]
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  phone       String?
  email       String?
  message     String?
  programmeId String?
  source      String     @default("Website")
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  status      LeadStatus @default(NEW)
  handledBy   String?
  createdAt   DateTime   @default(now())
}

model PageEvent {
  id          String   @id @default(cuid())
  type        String
  path        String
  programmeId String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  lang        String?
  device      String?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([programmeId])
}

model ApplicationDraft {
  id        String   @id @default(cuid())
  token     String   @unique
  data      Json
  step      Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
  uploads   Upload[]

  @@index([updatedAt])
}

model Upload {
  id          String            @id @default(cuid())
  kind        String
  filename    String
  mime        String
  size        Int
  data        Bytes
  draftId     String?
  draft       ApplicationDraft? @relation(fields: [draftId], references: [id], onDelete: Cascade)
  applicantId String?
  applicant   Applicant?        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([draftId])
  @@index([applicantId])
}

model Asset {
  id        String   @id @default(cuid())
  name      String
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

enum NotifyChannel {
  EMAIL
  WHATSAPP
}

enum NotifyStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id          String        @id @default(cuid())
  applicantId String
  applicant   Applicant     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  channel     NotifyChannel
  template    String
  to          String
  subject     String?
  body        String
  status      NotifyStatus  @default(QUEUED)
  error       String?
  createdAt   DateTime      @default(now())
  sentAt      DateTime?

  @@index([status, channel])
  @@index([applicantId])
}

/// One-time passcode sent to an applicant's email to prove ownership. Only a salted hash is stored.
model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

/// How many RWF one unit of a foreign currency is worth. Set by Finance (FIN-05).
model ExchangeRate {
  currency   Currency @id
  rwfPerUnit Float
  updatedBy  String?
  updatedAt  DateTime @default(now()) @updatedAt
}

/// A request from a student that staff approve or refuse: profile change, session change, or an official letter.
model StudentRequest {
  id          String    @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  type        String
  detail      Json      @default("{}")
  reason      String?
  status      String    @default("PENDING")
  note        String?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
}

model Ticket {
  id          String          @id @default(cuid())
  applicantId String
  applicant   Applicant       @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  subject     String
  category    String          @default("General")
  status      String          @default("OPEN")
  rating      Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now())
  messages    TicketMessage[]

  @@index([status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStaff Boolean  @default(false)
  author    String
  body      String
  createdAt DateTime @default(now())
}

/// A notice to all students or to one class group.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  groupId   String?
  createdBy String
  createdAt DateTime @default(now())
}

/// A test, assignment or exam for one class group. Grades are visible to students only when status is PUBLISHED.
model Assessment {
  id                 String       @id @default(cuid())
  groupId            String
  group              ClassGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title              String
  component          String
  maxScore           Float        @default(100)
  heldOn             DateTime?
  instructions       String?
  dueOn              DateTime?
  acceptsSubmissions Boolean      @default(false)
  status             String       @default("DRAFT")
  createdBy          String
  createdById        String?
  submittedBy        String?
  approvedBy         String?
  reviewNote         String?
  publishedAt        DateTime?
  createdAt          DateTime     @default(now())
  grades             Grade[]
  submissions        Submission[]

  @@index([groupId])
}

model Grade {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  applicantId  String
  applicant    Applicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  score        Float
  feedback     String?
  updatedBy    String?
  updatedAt    DateTime   @default(now())
  appeals      Appeal[]

  @@unique([assessmentId, applicantId])
}

model Submission {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  applicantId  String
  applicant    Applicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  filename     String
  mime         String
  size         Int
  data         Bytes
  note         String?
  submittedAt  DateTime   @default(now())

  @@unique([assessmentId, applicantId])
}

model Appeal {
  id          String    @id @default(cuid())
  gradeId     String
  grade       Grade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  applicantId String
  reason      String
  status      String    @default("PENDING")
  oldScore    Float?
  newScore    Float?
  note        String?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
}

/// An IATA or ICAO exam taken through the School. Certificates here are issued by IATA/ICAO, not by the School.
model ExternalExam {
  id                    String    @id @default(cuid())
  applicantId           String
  applicant             Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  body                  String
  examName              String
  status                String    @default("REQUESTED")
  feeAmount             Int?
  feeCurrency           String    @default("USD")
  feePaidToBodyOn       DateTime?
  examDate              DateTime?
  result                String?
  certificateNo         String?
  certificateReceivedOn DateTime?
  updatedBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())
}

/// Teaching staff record (LEC-01). Bank details and rate are sensitive: changes need a second approver (LEC-03).
model LecturerProfile {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String?
  nationalId     String?
  qualifications String?
  licences       String?
  industryRole   String?
  subjects       String[]  @default([])
  languages      String[]  @default([])
  branchIds      String[]  @default([])
  payModel       String    @default("HOUR")
  rate           Int       @default(0)
  currency       String    @default("RWF")
  payChannel     String    @default("BANK")
  bankName       String?
  accountNumber  String?
  taxStatus      String?
  contractStart  DateTime?
  contractEnd    DateTime?
  maxHoursWeek   Int       @default(20)
  availability   Json      @default("{}")
  onboarding     Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())
}

model ProfileChange {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields        Json
  previous      Json
  requestedBy   String
  requestedById String?
  status        String    @default("PENDING")
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
}

/// One per class session (LEC-13). onTime = submitted within 24 hours of the class.
model LessonReport {
  id         String        @id @default(cuid())
  slotId     String
  slot       TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  date       DateTime      @db.Date
  lecturerId String
  lecturer   User          @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  topic      String
  notes      String?
  issues     String?
  onTime     Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@unique([slotId, date])
}

model SubstituteRequest {
  id           String        @id @default(cuid())
  slotId       String
  slot         TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  date         DateTime      @db.Date
  lecturerId   String
  lecturer     User          @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  substituteId String?
  reason       String
  status       String        @default("PENDING")
  decidedBy    String?
  note         String?
  createdAt    DateTime      @default(now())
}

/// A lecturer's claim for one month, built from delivered sessions (LEC-18). Approval chain: coordinator, Head of Academics, Finance (LEC-20).
model PaymentClaim {
  id         String    @id @default(cuid())
  lecturerId String
  lecturer   User      @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  period     String
  payModel   String
  rate       Int
  currency   String
  units      Float
  amount     Int
  lines      Json
  clearance  Json
  status     String    @default("SUBMITTED")
  history    Json      @default("[]")
  paidRef    String?
  paidAt     DateTime?
  openQuery  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())

  @@unique([lecturerId, period])
}

/// LEC-07: a lecturer vacancy shown on the website while PUBLISHED and not past closesOn.
model Vacancy {
  id           String           @id @default(cuid())
  slug         String           @unique
  title        String
  subjects     String[]         @default([])
  description  String
  requirements String[]         @default([])
  branchId     String?
  branch       Branch?          @relation(fields: [branchId], references: [id])
  payModel     String           @default("HOUR")
  closesOn     DateTime?        @db.Date
  status       String           @default("DRAFT")
  createdBy    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now())
  applications JobApplication[]
}

/// LEC-08, LEC-10: an application with CV, screening answers, pipeline status, offer and onboarding checklist.
model JobApplication {
  id         String   @id @default(cuid())
  vacancyId  String
  vacancy    Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  reference  String   @unique
  fullName   String
  email      String
  phone      String
  coverNote  String?
  answers    Json     @default("{}")
  cvName     String
  cvMime     String
  cvSize     Int
  cv         Bytes
  status     String   @default("NEW")
  score      Int?
  history    Json     @default("[]")
  offer      Json?
  onboarding Json?
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@unique([vacancyId, email])
}

/// RES: a learning resource. Students see it only when APPROVED, visible to students, released, not expired and not in the recycle bin.
model Resource {
  groupId     String?
  id          String            @id @default(cuid())
  title       String
  description String?
  programmeId String?
  programme   Programme?        @relation(fields: [programmeId], references: [id])
  module      String?
  topic       String?
  kind        String            @default("NOTES")
  tags        String[]          @default([])
  language    String            @default("en")
  ownerId     String
  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status      String            @default("IN_REVIEW")
  visibility  String            @default("STUDENTS")
  releaseAt   DateTime?
  expiresAt   DateTime?
  licence     String            @default("School copyright")
  viewOnly    Boolean           @default(false)
  reviewedBy  String?
  reviewNote  String?
  version     Int               @default(1)
  views       Int               @default(0)
  downloads   Int               @default(0)
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now())
  versions    ResourceVersion[]

  @@index([programmeId, module])
}

model ResourceVersion {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  version    Int
  filename   String?
  mime       String?
  size       Int?
  data       Bytes?
  url        String?
  note       String?
  uploadedBy String
  createdAt  DateTime @default(now())

  @@unique([resourceId, version])
}
